API_ID=123456
API_HASH=abcdef1234567890
BOT_TOKEN=123456:ABC-DEF
OWNER_ID=123456789
DB_CHANNEL=-1001234567890
LOG_CHANNEL=-1001234567890
DATA_DIR=/data
AUTO_DELETE=1800
BOT_NAME=Harsh File Store Bot
PORT=8080
COLOR_BUTTONS=true

# ── Updates / Support ──
UPDATES_LINK=https://t.me/pm_harsh
SUPPORT_LINK=

# ── Force Sub (volume na ho to DB reset ho jata hai, isliye env se seed) ──
# comma se alag, request-mode ke liye :request lagao
# FSUB_CHANNELS=-1002644259946,-1001234567890:request,@mychannel
FSUB_CHANNELS=
FORCE_SUB=true

# ── Log channel me kya jaye ──
LOG_STARTUP=false     # "bot started" message (off rakho)
LOG_NEW_USER=true     # naya user start kare -> id + username
LOG_FILES=false       # har file delivery / batch (spammy)
